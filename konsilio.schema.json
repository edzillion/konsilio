{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Konsilio Configuration",
  "type": "object",
  "properties": {
    "personas": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["securityArchitect", "performanceEngineer", "uxDxDesigner", "devopsEngineer", "typescriptEngineer", "graphDba", "nodeFullstackEngineer", "devToolingSpecialist", "distributedSystemsEngineer", "testArchitect"]
          },
          "minItems": 2,
          "description": "Expert personas to include in council consultations"
        }
      },
      "required": ["enabled"]
    },
    "constitution": {
      "type": "string",
      "description": "Path to optional constitution file with custom workflow rules"
    },
    "models": {
      "type": "object",
      "properties": {
        "experts": { "type": "string", "description": "Model for expert personas" },
        "lead": { "type": "string", "description": "Model for consolidation phases" }
      }
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "expertMs": { "type": "integer", "minimum": 10000 },
        "leadMs": { "type": "integer", "minimum": 30000 }
      }
    },
    "maxDraftPlanLength": { "type": "integer", "minimum": 1000 },
    "maxHistorySessions": { "type": "integer", "minimum": 1, "maximum": 100 },
    "databasePath": { "type": "string" }
  },
  "required": ["personas"]
}
